# Copy to .env and fill in. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://jobagent_app:app@localhost:5432/jobagent
DATABASE_OWNER_URL=postgresql+psycopg://jobagent_owner:owner@localhost:5432/jobagent
REDIS_URL=redis://localhost:6379/0
# 32+ random characters; signs login tokens
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for encrypting mail tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash
GEMINI_MODEL_EMBED=gemini-embedding-001
# Google OAuth for Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/mail/google/callback
GOOGLE_PUBSUB_TOPIC=
# Job sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# In non-production every outgoing application is redirected here
SANDBOX_RECIPIENT=
FRONTEND_URL=http://localhost:3000
