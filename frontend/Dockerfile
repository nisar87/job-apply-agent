FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_HIDE_FROM_SEARCH=0
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_HIDE_FROM_SEARCH=$NEXT_PUBLIC_HIDE_FROM_SEARCH
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
ENV PORT=8080
EXPOSE 8080
CMD ["npm", "run", "start"]
