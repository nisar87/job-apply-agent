{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
      }
    ],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "jaa-api", "region": "europe-west1" } },
      { "source": "**", "run": { "serviceId": "jaa-web", "region": "europe-west1" } }
    ]
  }
}
